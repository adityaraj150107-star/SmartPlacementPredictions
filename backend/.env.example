# ---- REQUIRED ---------------------------------------------------------------
# Generate a real random value:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# First admin account (choose your own strong password before the first run)
ADMIN_EMAIL=admin@smartplacement.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# ---- AI (you need at least ONE of these two) --------------------------------
# Local & free: install Ollama, then run `ollama pull llama3.2`. python app.py starts it for you.
OLLAMA_MODEL=llama3.2
# Cloud (optional, needed to understand photos/sketches; also used as a fallback if Ollama is off).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# auto (default) | ollama | gemini
LLM_PROVIDER=auto

# ---- OTP email (configure ONCE; every new user then receives their own OTP automatically) ----
# Gmail App Password, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Phone / other devices ---------------------------------------------------
# true = also listen on your Wi-Fi network so a phone can open http://<PC-IP>:5000
LAN_ACCESS=false
PORT=5000

# ---- Other -------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
# development (default) or production (HTTPS-only cookies, debug forced off)
FLASK_ENV=development
FLASK_DEBUG=false
SESSION_TTL_DAYS=7
MAX_OTP_ATTEMPTS=5
